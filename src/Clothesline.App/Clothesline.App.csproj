<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>disable</ImplicitUsings>
    <PlatformTarget>x64</PlatformTarget>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>Clothesline</AssemblyName>
    <Version>0.16.1</Version>
    <!-- WPF owns startup and PMv2 via manifest; WinForms is used only for NotifyIcon. -->
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
  </PropertyGroup>
  <ItemGroup><ProjectReference Include="../Clothesline.Core/Clothesline.Core.csproj" /></ItemGroup>
  <ItemGroup><ProjectReference Include="../Clothesline.Storage/Clothesline.Storage.csproj" /></ItemGroup>
  <ItemGroup><EmbeddedResource Include="Fixtures/*" Exclude="Fixtures/*.md" LogicalName="Clothesline.Fixtures.%(Filename)%(Extension)" /></ItemGroup>
</Project>
