name: Build and core checks
on:
  push:
    branches: [main]
  pull_request:
permissions:
  contents: read
jobs:
  windows:
    runs-on: windows-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-dotnet@v4
        with:
          dotnet-version: '10.0.x'
      - name: Compile and verify rules
        shell: pwsh
        run: ./scripts/test.ps1
      - name: Publish prototype
        shell: pwsh
        run: ./scripts/publish.ps1
      - uses: actions/upload-artifact@v4
        with:
          name: Clothesline-0.19.2-win-x64
          path: dist/Clothesline-0.19.2-win-x64.zip
          retention-days: 14
